{
  "name": "bordero-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios --configuration Release --no-bundler",
    "android": "expo run:android --variant release --no-bundler",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prebuild": "expo prebuild",
    "export:check": "expo export --platform all --output-dir dist",
    "backend:bundle": "node scripts/bundle-canonical.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "@supabase/supabase-js": "2.99.2",
    "expo-system-ui": "~57.0.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/node": "^22.20.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  }
}
